# Custom health check message
PING_MESSAGE=pong

# Text agent on Groq. Set GROQ_API_KEY as a secret in the deployment environment.
# The chosen model supports text and tool calls.
AGENT_ENGINE=ai-sdk:groq
AGENT_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true
